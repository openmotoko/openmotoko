{
	"id": "gmail",
	"name": "Gmail",
	"version": "0.1.3",
	"description": "Read, send, search, and manage Gmail emails via the Google API",
	"author": "openmotoko",
	"capabilities": {
		"network": true,
		"env": ["GMAIL_CLIENT_ID", "GMAIL_CLIENT_SECRET", "GMAIL_REFRESH_TOKEN"]
	},
	"tools": [
		{
			"name": "read_inbox",
			"description": "Read recent emails from the inbox",
			"inputSchema": {
				"type": "object",
				"properties": {
					"limit": {
						"type": "number",
						"description": "Maximum number of emails to return (default 10)"
					},
					"query": {
						"type": "string",
						"description": "Optional Gmail search query to filter inbox results"
					}
				}
			}
		},
		{
			"name": "send_email",
			"description": "Send an email via Gmail",
			"inputSchema": {
				"type": "object",
				"properties": {
					"to": {
						"type": "string",
						"description": "Recipient email address"
					},
					"subject": {
						"type": "string",
						"description": "Email subject line"
					},
					"body": {
						"type": "string",
						"description": "Email body content (plain text)"
					},
					"cc": {
						"type": "string",
						"description": "CC recipient email address"
					},
					"bcc": {
						"type": "string",
						"description": "BCC recipient email address"
					}
				},
				"required": ["to", "subject", "body"]
			}
		},
		{
			"name": "search_emails",
			"description": "Search emails using Gmail search syntax",
			"inputSchema": {
				"type": "object",
				"properties": {
					"query": {
						"type": "string",
						"description": "Gmail search query (e.g., 'from:user@example.com subject:report')"
					},
					"limit": {
						"type": "number",
						"description": "Maximum number of results to return (default 10)"
					}
				},
				"required": ["query"]
			}
		},
		{
			"name": "get_email",
			"description": "Get the full content of a specific email by its ID",
			"inputSchema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"description": "The Gmail message ID"
					}
				},
				"required": ["id"]
			}
		},
		{
			"name": "label_email",
			"description": "Add or remove labels on an email",
			"inputSchema": {
				"type": "object",
				"properties": {
					"id": {
						"type": "string",
						"description": "The Gmail message ID"
					},
					"labels": {
						"type": "array",
						"items": { "type": "string" },
						"description": "Label names to apply to the email"
					}
				},
				"required": ["id", "labels"]
			}
		}
	]
}
