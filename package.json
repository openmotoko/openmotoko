{
  "name": "openmotoko",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Personal AI Agent for Humans",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "build": "pnpm -r build",
    "start": "node packages/api/dist/index.js",
    "dev": "pnpm --filter @openmotoko/api dev & pnpm --filter @openmotoko/web dev",
    "dev:api": "pnpm --filter @openmotoko/api dev",
    "dev:web": "pnpm --filter @openmotoko/web dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "db:generate": "pnpm --filter @openmotoko/core db:generate",
    "db:migrate": "pnpm --filter @openmotoko/core db:migrate",
    "version:patch": "tsx scripts/bump-version.ts patch",
    "version:minor": "tsx scripts/bump-version.ts minor",
    "version:major": "tsx scripts/bump-version.ts major"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@types/node": "^24.10.13",
    "@vitest/coverage-v8": "^4.0.18",
    "typescript": "^5.8.3",
    "vitest": "^4.0.18"
  }
}
